# Abfrageintervall in Sekunden (wie oft die Wechselrichter abgefragt werden)
POLL_INTERVAL_SECONDS=15

# Zeitzone fuer die "heute"-Tagessummen (Tagesgrenze = lokale Mitternacht)
TIMEZONE=Europe/Berlin

# Automatischer Abgleich mit dem internen Datenlogger der Wechselrichter
# beim Start (fuellt z.B. Luecken durch Ausfallzeiten). Mit false deaktivieren.
AUTO_IMPORT_HISTORY=true
# Wie viele Tage zurueck bei jedem Start automatisch abgeglichen werden.
# 35 deckt den "30 Tage"-Button im Dashboard mit etwas Puffer ab (begrenzt
# durch die Speichertiefe des internen Loggers am Wechselrichter selbst).
# Mit "unbegrenzt" (oder "0"/"all") wird stattdessen so weit wie moeglich
# zurueck abgeglichen - der Wechselrichter liefert ohnehin nur so viel
# Historie, wie sein interner Logger tatsaechlich noch vorhaelt.
AUTO_IMPORT_DAYS=35

# Falls Einspeisung/Netzbezug im Dashboard vertauscht erscheinen (haengt von
# der Installation/Zaehlerausrichtung ab): auf true setzen.
GRID_POWER_INVERTED=false

# --- Taeglicher Mail-Report (Zusammenfassung des Tages) ---
# Verschickt einmal taeglich eine Mail mit Status/Ertrag aller
# Wechselrichter ueber den zentralen Mail-Service (siehe
# https://github.com/broercon/Mailserver). Mit false komplett deaktivieren.
DAILY_REPORT_ENABLED=true
# Uhrzeit (lokale TIMEZONE), Format HH:MM. Aenderung erfordert einen
# Container-Neustart (wie die meisten anderen Einstellungen hier) - zum
# Testen der aktuellen Konfiguration ohne Neustart/Warten stattdessen
# POST /api/admin/daily-report/trigger verwenden.
DAILY_REPORT_TIME=19:00
# Empfaenger-Adressen, kommagetrennt
DAILY_REPORT_RECIPIENTS=deine-adresse@example.com
# REST-Endpoint des Mail-Service inkl. Pfad. Da Mailserver und dieser
# Monitor i.d.R. getrennte docker-compose-Projekte sind, muss der Host von
# hier aus erreichbar sein - z.B. die LAN-IP/der Hostname des Servers plus
# den veroeffentlichten Port (Mailserver-Default 8080), oder ein
# gemeinsames externes Docker-Netzwerk (siehe README).
MAIL_SERVICE_URL=http://mail-api:8080/send
# Muss einem der API_KEYS beim Mail-Service entsprechen.
MAIL_SERVICE_API_KEY=
# Optionaler Absender-Anzeigename in der verschickten Mail.
MAIL_SERVICE_FROM_NAME=Kostal Plenticore Monitor
