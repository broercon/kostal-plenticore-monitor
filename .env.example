# Abfrageintervall in Sekunden (wie oft die Wechselrichter abgefragt werden)
POLL_INTERVAL_SECONDS=15

# Zeitzone fuer die "heute"-Tagessummen (Tagesgrenze = lokale Mitternacht)
TIMEZONE=Europe/Berlin

# Automatischer Abgleich mit dem internen Datenlogger der Wechselrichter
# beim Start (fuellt z.B. Luecken durch Ausfallzeiten). Mit false deaktivieren.
AUTO_IMPORT_HISTORY=true
# Wie viele Tage zurueck bei jedem Start automatisch abgeglichen werden.
AUTO_IMPORT_DAYS=7
